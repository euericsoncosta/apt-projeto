generator client{
    provider = "prisma-client-js"
}
// Banco de dados: SQLite 
datasource db{
    provider = "sqlite"
    url = env("DATABASE_URL")
}
model Aluno{
    id Int @id @default(autoincrement())
    nome String
    email String @unique
    idade Int
    criadoEM DateTime @default(now())
    @@map("alunos")
}